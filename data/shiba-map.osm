 <node id="12531761001" visible="true" version="2" changeset="161748057" timestamp="2025-01-25T14:19:26Z" user="Anonymous897234" uid="16885157" lat="35.6648222" lon="139.7455093">
  <tag k="amenity" v="bar"/>
  <tag k="contact:facebook" v="GoldBarEDITION"/>
  <tag k="contact:instagram" v="GoldBarEDITION"/>
  <tag k="contact:tripadvisor" v="https://tripadvisor.com/Restaurant_Review-g14129647-d23558181-Reviews-Gold_Bar_at_EDITION-Toranomon_Minato_Tokyo_Tokyo_Prefecture_Kanto.html"/>
  <tag k="description" v="エディションのゴールドバーは、現代的なひねりを加えた禁酒法前のカクテル時代を再想像し、ゲストにブラックライトで照らされた隠れたメニューを探求するよう招待します。バーディレクターの斎藤秀幸の専門知識のもと、バーではユニークな名前のカクテルが提供され、それぞれに物語が添えられています。新鮮なメロンを使ったミドリサワーや、寿司のエッセンスを飲み物に表現した革新的なクミンとマンゴーの握りカクテルなどがあります。"/>
  <tag k="description:en" v="Gold Bar at Edition blends pre-prohibition cocktail elegance with modern flair, featuring a hidden menu revealed by black lights and creatively presented drinks like a fresh melon Midori Sour."/>
  <tag k="description:ja" v="エディションのゴールドバーは、現代的なひねりを加えた禁酒法前のカクテル時代を再想像し、ゲストにブラックライトで照らされた隠れたメニューを探求するよう招待します。バーディレクターの斎藤秀幸の専門知識のもと、バーではユニークな名前のカクテルが提供され、それぞれに物語が添えられています。新鮮なメロンを使ったミドリサワーや、寿司のエッセンスを飲み物に表現した革新的なクミンとマンゴーの握りカクテルなどがあります。"/>
  <tag k="email" v="goldbar@editionhotels.com"/>
  <tag k="name" v="Gold Bar at EDITION"/>
  <tag k="opening_hours" v="Mo off; Tu-Th 18:00-01:00; Fr 18:00-02:00; Sa 18:00-02:00; Su off"/>
  <tag k="phone" v="+81-3-5422-1630"/>
  <tag k="reservation" v="yes"/>
  <tag k="website" v="https://goldbaratedition.com"/>
  <tag k="website:reservation" v="https://tablecheck.com/ja/shops/editionhotels-tokyo-goldbar/reserve"/>
 </node>
