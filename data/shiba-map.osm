 <node id="7026315189" visible="true" version="2" changeset="188390474" timestamp="2026-09-01T21:35:03Z" user="Monolo23" uid="17519482" lat="35.6579037" lon="139.7486566">
  <tag k="board_type" v="notice"/>
  <tag k="description:es" v="Estas estatuas fueron erigidas rezando por el crecimiento sano y seguro de hijos y nietos. Como expresión de cariño, se ofrecen a Jizo sombreros rojos, delantales rojos y molinillos para proteger a los niños. No toque las estatuas del bodhisattva Jizo."/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="子や孫の無事成長を祈って当寺まわり講の方々が中心となって、それぞれのお施主様がお建てになりました。幼い子や孫への愛情の表れとして、頭を守り、寒さをしのぐ為の「赤い帽子」「赤い前掛け」「風車」をお地蔵さまに奉納しています。地蔵菩薩像には触らないでください。"/>
  <tag k="name" v="千躰子育地蔵菩薩"/>
  <tag k="name:es" v="Mil Bodhisattvas Jizo Protectores de los Niños"/>
  <tag k="name:ja" v="千躰子育地蔵菩薩"/>
  <tag k="name:ja-Hira" v="せんたいこそだてじぞうぼさつ"/>
  <tag k="name:ja-Latn" v="Sentai Kosodate Jizō Bosatsu"/>
  <tag k="tourism" v="information"/>
 </node>
